# PhotoRAW deployment config — copy to .env and fill in. docker-compose reads this
# file for every service; the app also loads it when run outside Docker.

# --- AI analysis (Stage 3) --------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional: local/OpenAI-compatible vision model instead
#ANTHROPIC_BASE_URL=http://host.docker.internal:1234
#PIPELINE_MODEL=deepseek-v4-flash

# --- Web UI -----------------------------------------------------------------
WEBUI_PORT=8765
# Fallback auth when Keycloak is NOT used: protects the operator UI/API (HTTP Basic,
# single admin). Ignored once KEYCLOAK_URL is set. Leave blank only for local dev.
PIPELINE_WEBUI_PASSWORD=change-me

# --- Authentication (Keycloak: multi-user + roles + Users panel) -------------
# Leave KEYCLOAK_URL blank to run with the single admin password above instead.
# With the bundled `auth` compose profile, Keycloak runs at http://keycloak:8080.
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=photoraw
KEYCLOAK_CLIENT_ID=photoraw-app
# Must equal the client secret in keycloak/realm-photoraw.json (edit both together)
KEYCLOAK_CLIENT_SECRET=CHANGE-ME-client-secret
# Signs session cookies — set a long random value (e.g. `openssl rand -hex 32`)
SESSION_SECRET=CHANGE-ME-random-hex
# Keycloak's own admin console + DB (only used by the `auth` profile)
KC_ADMIN=kcadmin
KC_ADMIN_PASSWORD=change-me-kc-admin
KC_DB_PASSWORD=change-me-kc-db
KEYCLOAK_PORT=8080
# The initial PhotoRAW super admin (from realm-photoraw.json) is username "admin";
# set its password by replacing CHANGE-ME-admin-password in that file before first run.

# --- Object storage (S3-compatible) ------------------------------------------
# "local" = files stay on the data volume only. "s3" = durable artifacts are
# mirrored to the service below and re-downloaded on demand (the volume becomes
# a rebuildable cache).
PIPELINE_STORAGE=s3
# External service (AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces…):
#   S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# Self-hosted MinIO from the local-s3 compose profile:
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=photoraw
S3_SECRET_KEY=change-me-long-random
S3_BUCKET=photoraw
#S3_REGION=us-east-1
#S3_PREFIX=studio1

# --- Ingest ------------------------------------------------------------------
# Host directory watched for new RAW files (mounted at /data/inbox in the worker)
INBOX_DIR=./inbox

# --- Optional generative fill (ComfyUI, runs outside compose) -----------------
#COMFYUI_URL=http://host.docker.internal:8188
