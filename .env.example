# PhotoRAW deployment config — copy to .env and fill in. docker-compose reads this
# file for every service; the app also loads it when run outside Docker.

# --- AI analysis (Stage 3) --------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional: local/OpenAI-compatible vision model instead
#ANTHROPIC_BASE_URL=http://host.docker.internal:1234
#PIPELINE_MODEL=deepseek-v4-flash
ANTHROPIC_BASE_URL=http://localhost:1234
PIPELINE_MODEL=qwen3-vl-8b-instruct

# --- Web UI -----------------------------------------------------------------
WEBUI_PORT=8765
# Fallback auth when Keycloak is NOT used: protects the operator UI/API (HTTP Basic,
# single admin). Ignored once KEYCLOAK_URL is set. Leave blank only for local dev.
PIPELINE_WEBUI_PASSWORD=change-me

# --- Authentication (Keycloak: multi-user + roles + Users panel) -------------
# Leave KEYCLOAK_URL blank to run with the single admin password above instead.
# With the bundled `auth` compose profile, Keycloak runs at http://keycloak:8080.
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=photoraw
KEYCLOAK_CLIENT_ID=photoraw-app
# Must equal the client secret in keycloak/realm-photoraw.json (edit both together)
KEYCLOAK_CLIENT_SECRET=CHANGE-ME-client-secret
# Signs session cookies — set a long random value (e.g. `openssl rand -hex 32`)
SESSION_SECRET=CHANGE-ME-random-hex
# Keycloak's own admin console + DB (only used by the `auth` profile)
KC_ADMIN=kcadmin
KC_ADMIN_PASSWORD=change-me-kc-admin
KC_DB_PASSWORD=change-me-kc-db
KEYCLOAK_PORT=8080
# The initial PhotoRAW super admin (from realm-photoraw.json) is username "admin";
# set its password by replacing CHANGE-ME-admin-password in that file before first run.

# --- Database ----------------------------------------------------------------
# Default (empty/unset): SQLite file on the data volume — zero-config, single node.
# To use PostgreSQL, set a URL here. The bundled `db` service is available behind the
# `postgres` profile (docker compose --profile postgres up -d); point the URL at @db:5432
# and set DB_PASSWORD. Or point at any external Postgres and skip the profile.
#PIPELINE_DATABASE_URL=postgresql://photoraw:change-me-db@db:5432/photoraw
#DB_PASSWORD=change-me-db
#DB_USER=photoraw
#DB_NAME=photoraw

# --- Object storage (S3-compatible) ------------------------------------------
# "local" = files stay on the data volume only. "s3" = durable artifacts are
# mirrored to the service below and re-downloaded on demand (the volume becomes
# a rebuildable cache).
PIPELINE_STORAGE=s3
# External service (AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces…):
#   S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# Self-hosted MinIO from the local-s3 compose profile:
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=photoraw
S3_SECRET_KEY=change-me-long-random
S3_BUCKET=photoraw
#S3_REGION=us-east-1
#S3_PREFIX=studio1
# Client-side (end-to-end) encryption: when set, files are encrypted on this host
# BEFORE upload and decrypted after download, so the bucket only ever holds
# ciphertext (the provider and anyone with the S3 keys can't read your photos).
# Value: a 32-byte key as base64 (recommended) or 64-char hex; anything else is
# treated as a passphrase. Generate one:  openssl rand -base64 32
# WARNING: keep this safe and unchanged — lose it and every remote-only photo is
# permanently unrecoverable. Leave empty to disable.
#STORAGE_ENCRYPTION_KEY=

# --- Ingest ------------------------------------------------------------------
# Host directory watched for new RAW / camera JPG files (mounted at /data/inbox in the worker)
INBOX_DIR=./inbox

# --- Background ---------------------------------------------------------------
# 1 (default): photos with a studio backdrop get it rebuilt clean across the whole
# frame (wrinkles, folds, shoe marks, visible stands/walls/floor removed); real
# scenes are kept. 0: never touch the background unless --background is passed.
#PIPELINE_AUTO_STUDIO_BG=1
#PIPELINE_EXPAND_SHADOW=0.6   # how much of the subject's real cast shadow to keep (0-1)
#PIPELINE_EXPAND_GRAIN=1.0    # grain matched to the backdrop (0 = none)
#PIPELINE_EXPAND_GENERATIVE=1 # refine the extension over walls/softboxes with ComfyUI
#PIPELINE_EXPAND_COMFY_DENOISE=0.35

# --- Optional generative fill (ComfyUI, runs outside compose) -----------------
#COMFYUI_URL=http://host.docker.internal:8188
# auto = FLUX.1 Fill (GGUF, crop-and-stitch) when ComfyUI has it, else the SD1.5 checkpoint
#COMFYUI_ENGINE=auto          # auto | flux | sd15
#COMFYUI_FLUX_UNET=flux1-fill-dev-Q8_0.gguf   # models/unet (needs the ComfyUI-GGUF node)
#COMFYUI_FLUX_T5=t5xxl_fp16.safetensors       # models/text_encoders (+ clip_l.safetensors, vae/ae.safetensors)
#COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors
